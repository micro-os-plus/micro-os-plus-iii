{
  "name": "@micro-os-plus/micro-os-plus-iii",
  "version": "7.2.0-pre",
  "description": "A source code library with the portable part of µOS++ IIIe",
  "keywords": [
    "xpack",
    "c++",
    "micro-os-plus"
  ],
  "license": "MIT",
  "author": {
    "name": "Liviu Ionescu",
    "email": "ilg@livius.net",
    "url": "https://github.com/ilg-ul"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micro-os-plus/micro-os-plus-iii.git"
  },
  "homepage": "https://micro-os-plus.github.io/micro-os-plus-iii/",
  "bugs": {
    "url": "https://github.com/micro-os-plus/micro-os-plus-iii/issues"
  },
  "$dependenciesUrls": {
    "glob": "https://www.npmjs.com/package/glob",
    "del-cli": "https://www.npmjs.com/package/del-cli",
    "json": "https://www.npmjs.com/package/json",
    "json5": "https://www.npmjs.com/package/json5",
    "jsonc-parser": "https://www.npmjs.com/package/jsonc-parser",
    "liquidjs": "https://www.npmjs.com/package/liquidjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@xpack/npm-packages-helper": "github:xpack/npm-packages-helper",
    "del-cli": "^8.0.1",
    "glob": "^14.0.4",
    "json": "^11.0.0",
    "json5": "^2.2.3",
    "jsonc-parser": "^3.3.1",
    "liquidjs": "^10.30.1",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "generate-top-commons": "node node_modules/@xpack/npm-packages-helper/maintenance/scripts/generate-top-commons.mjs --micro-os-plus",
    "npm-install": "npm install",
    "npm-link-helper": "npm link @xpack/npm-packages-helper",
    "npm-outdated": "npm outdated",
    "npm-ci": "npm ci",
    "npm-pack": "npm pack",
    "npm-link": "npm link",
    "git-log": "git log --pretty='%cd * %h %s' --date=short",
    "update-changelog": "node maintenance/scripts/update-changelog.mjs CHANGELOG.md",
    "git-pull-helper": "git -C ${HOME}/Work/micro-os-plus/build-helper-xpack.git pull",
    "deep-clean": "del-cli node_modules package-lock.json *.tgz",
    "postversion": "git push origin --all && git push origin --tags"
  },
  "xpack": {
    "minimumXpmRequired": "0.20.8",
    "devDependencies": {
      "@xpack-dev-tools/clang": "21.1.8-1.1"
    },
    "actions": {
      "xpm-link": "xpm link",
      "clang-format": "node maintenance/scripts/clang-format.mjs",
      "cmake-format": "node maintenance/scripts/cmake-format.mjs",
      "jsonc-format": "node maintenance/scripts/jsonc-format.mjs",
      "xcdl-export": "node maintenance/scripts/xcdl-export.mjs xcdl-package.json*"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
