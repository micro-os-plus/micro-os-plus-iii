/*********************************************************************
*
*       OnProjectLoad
*
* Function description
*   Project load routine. Required.
*
**********************************************************************
*/
void OnProjectLoad (void) {
  //
  // Dialog-generated settings
  //
  Project.SetDevice ("STM32F411RE");
  Project.SetHostIF ("USB", "");
  Project.SetTargetIF ("SWD");
  Project.SetTIFSpeed ("4 MHz");
  // Project.AddPathSubstitute ("/Users/ilg/MyProjects/micro-os-plus.github/micro-os-plus-iii/micro-os-plus-iii.git/tests/rtos-apis-test", "$(ProjectDir)");
  // Project.AddPathSubstitute ("/users/ilg/myprojects/micro-os-plus.github/micro-os-plus-iii/micro-os-plus-iii.git/tests/rtos-apis-test", "$(ProjectDir)");
  //
  // User settings
  //
  Edit.SysVar (VAR_BREAK_AT_THIS_SYMBOL, "os_main");
  File.Open ("../../build/nucleo-f411re-cmake-debug/platform-bin/rtos-apis-instrumentation-test.elf");

}

