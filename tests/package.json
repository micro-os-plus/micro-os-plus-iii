{
  "name": "tests",
  "version": "0.0.0",
  "description": "Tests",
  "license": "MIT",
  "author": {
    "name": "Liviu Ionescu",
    "email": "ilg@livius.net",
    "url": "https://github.com/ilg-ul"
  },
  "dependencies": {},
  "devDependencies": {
    "del-cli": "^8.0.1"
  },
  "scripts": {
    "npm-ci": "npm ci",
    "npm-install": "npm install",
    "npm-outdated": "npm outdated",
    "deep-clean": "del-cli build node_modules xpacks package-json.json"
  },
  "xpack": {
    "minimumXpmRequired": "0.23.2",
    "dependencies": {},
    "$devDependenciesUrls": [
      "https://github.com/micro-os-plus",
      "https://github.com/xpack-3rd-party",
      "https://github.com/xpack-dev-tools"
    ],
    "devDependencies": {
      "@xpack-dev-tools/cmake": "3.26.5-1.1",
      "@xpack-dev-tools/ninja-build": "1.11.1-3.1",
      "@micro-os-plus/build-helper": "^2.17.0",
      "@xpack-3rd-party/arm-cmsis-rtos-validator": "github:xpack-3rd-party/arm-cmsis-rtos-validator-xpack#v1.0.0-5",
      "@xpack-3rd-party/chan-fatfs": "github:xpack-3rd-party/chan-fatfs-xpack#v0.13.1-6"
    },
    "properties": {
      "dependencies-releases": {
        "@micro-os-plus/posix-arch": "github:micro-os-plus/micro-os-plus-iii-posix-arch#v1.1.0",
        "@micro-os-plus/micro-os-plus-iii-cortexm": "github:micro-os-plus/micro-os-plus-iii-cortexm#v1.2.0",
        "@xpack-3rd-party/libucontext": "github:xpack-3rd-party/libucontext-xpack#v1.2.0-6",
        "@xpack-3rd-party/arm-cmsis-core": "5.4.0-7",
        "@xpack-3rd-party/raspberrypi-pico-sdk": "2.3.0-6",
        "@xpack-segger/rtt": "github:xpack-3rd-party/segger-rtt-xpack#v8.56.1-2",
        "@xpack-segger/system-view": "github:xpack-3rd-party/segger-system-view-xpack#v3.60.5-2",
        "@xpack-dev-tools/qemu-arm": "9.2.4-1.1",
        "@xpack-dev-tools/qemu-riscv": "9.2.4-1.1",
        "@xpack-dev-tools/openocd": "0.12.0-7.1"
      },
      "buildVerbose": "false",
      "buildFolderRelativePath": "{{ 'build' | path_join: configuration.name | to_filename | downcase }}",
      "buildFolderRelativePathPosix": "{{ 'build' | path_posix_join: configuration.name | downcase }}",
      "commandClearBuildFolder": "node scripts/clear-build-folder.mjs {{ properties.buildFolderRelativePathPosix }}",
      "commandCMakeGenerateNativePosix": "{{ properties.commandCMakeRefresh }} --log-level=VERBOSE",
      "commandCMakeGenerateNativePosixWithToolchain": "{{ properties.commandCMakeGenerateNativePosix }} -D CMAKE_TOOLCHAIN_FILE=cmake/toolchains/{{ properties.toolchainFileName }}",
      "commandCMakeGenerateCross": "{{ properties.commandCMakeRefresh }} --log-level=VERBOSE -D CMAKE_TOOLCHAIN_FILE={% if os.platform == 'win32' %}%CD%/cmake/toolchains/{{ properties.toolchainFileName }}{% else %}$(pwd)/cmake/toolchains/{{ properties.toolchainFileName }}{% endif %}",
      "commandCMakeRefresh": "cmake -S . -B {{ properties.buildFolderRelativePathPosix }} -G Ninja{% if os.platform == 'win32' %} -D CMAKE_MAKE_PROGRAM=ninja.cmd{% endif %} -D CMAKE_BUILD_TYPE={{ properties.buildType }} -D PLATFORM_NAME={{ properties.platformName }} -D CMAKE_EXPORT_COMPILE_COMMANDS=ON",
      "commandCMakeBuild": "cmake --build {{ properties.buildFolderRelativePathPosix }}{% if properties.buildVerbose == 'true' %} --verbose{% endif %}",
      "commandCMakeClean": "cmake --build {{ properties.buildFolderRelativePathPosix }} --target clean",
      "commandCMakePerformTests": "ctest -V --test-dir {{ properties.buildFolderRelativePath }}",
      "commandMesonSetupNativePosix": "meson setup --backend ninja --buildtype {{ properties.buildType }} -D platform-name={{ properties.platformName }} {{ properties.buildFolderRelativePathPosix }} .",
      "commandMesonSetupNativePosixWithToolchain": "meson setup --backend ninja --buildtype {{ properties.buildType }} -D platform-name={{ properties.platformName }} --native-file meson/toolchains/{{ properties.toolchainFileName }} --native-file platforms/{{ properties.platformName }}/meson/native.ini {{ properties.buildFolderRelativePathPosix }} .",
      "commandMesonSetupCross": "meson setup --backend ninja --buildtype {{ properties.buildType }} -D platform-name={{ properties.platformName }} --cross meson/toolchains/{{ properties.toolchainFileName }} --cross platforms/{{ properties.platformName }}/meson/cross.ini {{ properties.buildFolderRelativePathPosix }} .",
      "commandMesonRefresh": "meson setup --reconfigure {{ properties.buildFolderRelativePathPosix }} .",
      "commandMesonBuild": "meson compile -C {{ properties.buildFolderRelativePathPosix }}{% if properties.buildVerbose == 'true' %} --verbose{% endif %}",
      "commandMesonClean": "meson compile -C {{ properties.buildFolderRelativePathPosix }} --clean",
      "commandMesonPerformTests": "meson test -C {{ properties.buildFolderRelativePathPosix }} --verbose",
      "commandXcdlSetupNative": "echo xcdl setup --configuration-file xcdl-project.jsonc --build-folder {{ properties.buildFolderRelativePathPosix }} --builder ninja",
      "commandXcdlSetupNativeWithToolchain": "echo xcdl setup --configuration-file xcdl-project.jsonc --toolchain-file xcdl/toolchains/{{ properties.toolchainFileName }} --build-folder {{ properties.buildFolderRelativePathPosix }} --builder ninja",
      "commandXcdlSetupCross": "echo xcdl setup --configuration-file xcdl-project.jsonc --property platformName={{ properties.platformName }} --toolchain-file xcdl/toolchains/{{ properties.toolchainFileName }} --build-folder {{ properties.buildFolderRelativePathPosix }} --builder ninja",
      "commandXcdlRefresh": "echo xcdl setup --refresh --build-folder {{ properties.buildFolderRelativePathPosix }}",
      "commandXcdlBuild": "echo xcdl build -C {{ properties.buildFolderRelativePathPosix }}{% if properties.buildVerbose == 'true' %} --verbose{% endif %}",
      "commandXcdlClean": "echo xcdl build -C {{ properties.buildFolderRelativePathPosix }} --target clean",
      "commandXcdlPerformTests": "echo xcdl test -C {{ properties.buildFolderRelativePathPosix }} --verbose",
      "configs-ci-non-darwin": [
        "synthetic-posix-cmake-gcc"
      ],
      "configs-ci": [
        "synthetic-posix-cmake-clang",
        "qemu-cortex-m0-cmake-gcc",
        "qemu-cortex-m33-cmake-gcc",
        "qemu-cortex-m7f-cmake-gcc"
      ],
      "configs-selected-non-darwin": [
        "synthetic-posix-cmake-gcc"
      ],
      "configs-selected": [
        "synthetic-posix-cmake-clang",
        "qemu-cortex-m0-cmake-gcc",
        "qemu-cortex-m7f-cmake-gcc",
        "qemu-cortex-m33-cmake-gcc"
      ],
      "$configs-boards": [
        "Template, define configs-boards and select only the platforms in use",
        "nucleo-f411re",
        "nucleo-f411re-cubemx",
        "nucleo-f411re-cubemx-startup",
        "nucleo-f767zi",
        "nucleo-f767zi-cubemx",
        "nucleo-h533re",
        "nucleo-h533re-cubemx",
        "raspberry-pi-pico",
        "raspberry-pi-pico-sdk",
        "raspberry-pi-pico-2-arm",
        "raspberry-pi-pico-2-arm-sdk",
        "raspberry-pi-pico-2-riscv",
        "raspberry-pi-pico-2-riscv-sdk"
      ],
      "configs-boards": [
        "nucleo-f411re",
        "nucleo-f767zi",
        "nucleo-h533re"
      ],
      "$configs-platforms-vectors": {
        "Template": "define configs-platforms-vectors and select only the boards in use",
        "nucleo-f411re-cubemx": "stm32f411xe",
        "nucleo-f767zi-cubemx": "stm32f767xx",
        "nucleo-h533re-cubemx": "stm32h533xx"
      },
      "configs-platforms-vectors": {
        "nucleo-f411re-cubemx": "stm32f411xe",
        "nucleo-f767zi-cubemx": "stm32f767xx",
        "nucleo-h533re-cubemx": "stm32h533xx"
      },
      "$configs-platforms-device-folders": {
        "Template": "define configs-platforms-device-folders for the vectors platforms whose device folder is not named 'device'",
        "nucleo-f411re-cubemx": "device-stm32f411re",
        "nucleo-f767zi-cubemx": "device-stm32f767zi",
        "nucleo-h533re-cubemx": "device-stm32h533re"
      },
      "configs-platforms-device-folders": {
        "nucleo-f411re-cubemx": "device-stm32f411re",
        "nucleo-f767zi-cubemx": "device-stm32f767zi",
        "nucleo-h533re-cubemx": "device-stm32h533re"
      },
      "configs-platforms-vectors-names": [
        "{{ properties.configs-platforms-vectors | keys | join_lines }}"
      ],
      "$native-gcc-url": "https://www.npmjs.com/package/@xpack-dev-tools/gcc",
      "native-gcc-releases": {
        "11": {
          "specifier": "11.5.0-2.1",
          "platforms": "linux-x64,linux-arm64,win32-x64"
        },
        "12": {
          "specifier": "12.5.0-1.1",
          "platforms": "linux-x64,linux-arm64,win32-x64"
        },
        "13": {
          "specifier": "13.4.0-1.1",
          "platforms": "linux-x64,linux-arm64,win32-x64"
        },
        "14": {
          "specifier": "14.3.0-1.1",
          "platforms": "linux-x64,linux-arm64,win32-x64"
        },
        "15": {
          "specifier": "15.2.0-1.1",
          "platforms": "linux-x64,linux-arm64,win32-x64"
        }
      },
      "native-gcc-versions": [
        "{{ properties.native-gcc-releases | keys | reverse | join_lines }}"
      ],
      "$native-clang-url": "https://www.npmjs.com/package/@xpack-dev-tools/clang",
      "native-clang-releases": {
        "17": "17.0.6-3.1",
        "18": "18.1.8-2.1",
        "19": "19.1.7-1.1",
        "20": "20.1.8-1.1",
        "21": "21.1.8-1.1"
      },
      "native-clang-versions": [
        "{{ properties.native-clang-releases | keys | reverse | join_lines }}"
      ],
      "$arm-none-eabi-gcc-url": "https://www.npmjs.com/package/@xpack-dev-tools/arm-none-eabi-gcc",
      "arm-none-eabi-gcc-releases": {
        "11": "11.3.1-1.1.2",
        "12": "12.3.1-1.2.1",
        "13": "13.3.1-1.1.1",
        "14": "14.2.1-1.1.1",
        "15": "15.2.1-1.1.1"
      },
      "arm-none-eabi-gcc-versions": [
        "{{ properties.arm-none-eabi-gcc-releases | keys | reverse | join_lines }}"
      ],
      "$aarch64-none-elf-gcc-url": "https://www.npmjs.com/package/@xpack-dev-tools/aarch64-none-elf-gcc",
      "aarch64-none-elf-gcc-releases": {
        "11": "11.3.1-1.2.1",
        "12": "12.3.1-2.1.1",
        "13": "13.3.1-1.1.2",
        "14": "14.2.1-1.1.1",
        "15": "15.2.1-1.1.1"
      },
      "aarch64-none-elf-gcc-versions": [
        "{{ properties.aarch64-none-elf-gcc-releases | keys | reverse | join_lines }}"
      ],
      "$riscv-none-elf-gcc-url": "https://www.npmjs.com/package/@xpack-dev-tools/riscv-none-elf-gcc",
      "riscv-none-elf-gcc-releases": {
        "11": "11.5.0-2.1",
        "12": "12.5.0-1.1",
        "13": "13.4.0-1.1",
        "14": "14.3.0-1.1",
        "15": "15.2.0-1.1"
      },
      "riscv-none-elf-gcc-versions": [
        "{{ properties.riscv-none-elf-gcc-releases | keys | reverse | join_lines }}"
      ],
      "$dependencies-urls": [
        "https://github.com/micro-os-plus/micro-os-plus-iii-posix-arch/tags",
        "https://github.com/pack-3rd-party/libucontext-xpack/tags",
        "https://github.com/micro-os-plus/micro-os-plus-iii-cortexm/tags",
        "https://www.npmjs.com/package/@xpack-3rd-party/arm-cmsis-core",
        "https://www.npmjs.com/package/@xpack-3rd-party/raspberrypi-pico-sdk",
        "https://github.com/xpack-3rd-party/segger-rtt-xpack/tags",
        "https://github.com/xpack-3rd-party/segger-system-view-xpack/tags",
        "https://www.npmjs.com/package/@xpack-dev-tools/qemu-arm",
        "https://www.npmjs.com/package/@xpack-dev-tools/qemu-riscv",
        "https://www.npmjs.com/package/@xpack-dev-tools/openocd"
      ],
      "synthetic-posix-dependencies": [
        "@micro-os-plus/architecture-synthetic-posix"
      ],
      "qemu-cortex-variants": [
        "m0",
        "m3",
        "m4f",
        "m7f",
        "m33"
      ],
      "qemu-aarch32-variants": [],
      "qemu-aarch64-variants": [],
      "qemu-riscv-variants": [],
      "builders": [
        "cmake"
      ],
      "build-types": [
        "debug",
        "release"
      ],
      "test-actions": [
        "setup",
        "build",
        "test"
      ],
      "add-synthetic-posix-sys-to-configs-for-builder": "{% assign config = 'synthetic-posix-' | append: builder | append: '-sys' %}{% assign configs = configs | push: config %}",
      "add-synthetic-posix-gcc-to-configs-for-builder": "{% assign config = 'synthetic-posix-' | append: builder | append: '-gcc' %}{% assign configs = configs | push: config %}",
      "add-synthetic-posix-clang-to-configs-for-builder": "{% assign config = 'synthetic-posix-' | append: builder | append: '-clang' %}{% assign configs = configs | push: config %}",
      "add-synthetic-posix-to-configs-for-builder": "{% if os.platform == 'win32' %}{{ properties.add-synthetic-posix-gcc-to-configs-for-builder }}{% else %}{{ properties.add-synthetic-posix-sys-to-configs-for-builder }}{% endif %}",
      "compute-default-cmake-configs": "{% assign configs = '' | split: '' %}{% assign builder = 'cmake' %}{{ properties.add-synthetic-posix-to-configs-for-builder }}",
      "compute-default-meson-configs": "{% assign configs = '' | split: '' %}{% assign builder = 'meson' %}{{ properties.add-synthetic-posix-to-configs-for-builder }}",
      "compute-default-xcdl-configs": "{% assign configs = '' | split: '' %}{% assign builder = 'xcdl' %}{{ properties.add-synthetic-posix-to-configs-for-builder }}",
      "compute-default-configs": "{% assign configs = '' | split: '' %}{% for builder in properties.builders %}{{ properties.add-synthetic-posix-to-configs-for-builder }}{% endfor %}",
      "add-ci-non-darwin-configs": "{% for config in properties.configs-ci-non-darwin %}{% assign configs = configs | push: config %}{% endfor %}",
      "add-ci-configs": "{% for config in properties.configs-ci %}{% assign configs = configs | push: config %}{% endfor %}",
      "compute-ci-configs": "{% assign configs = '' | split: '' %}{% if os.platform != 'darwin' %}{{ properties.add-ci-non-darwin-configs }}{% endif %}{{ properties.add-ci-configs }}",
      "add-selected-configs": "{% for config in properties.configs-selected %}{% assign configs = configs | push: config %}{% endfor %}",
      "add-selected-non-darwin-configs": "{% for config in properties.configs-selected-non-darwin %}{% assign configs = configs | push: config %}{% endfor %}",
      "compute-selected-configs": "{% assign configs = '' | split: '' %}{% if os.platform != 'darwin' %}{{ properties.add-selected-non-darwin-configs }}{% endif %}{{ properties.add-selected-configs }}",
      "add-qemu-cortex-variants-to-configs-for-builder": "{% for variant in properties.qemu-cortex-variants %}{% assign config = 'qemu-cortex-' | append: variant | append: '-' | append: builder | append: '-gcc' %}{% assign configs = configs | push: config %}{% endfor %}",
      "add-qemu-aarch32-variants-to-configs-for-builder": "{% for variant in properties.qemu-aarch32-variants %}{% assign config = 'qemu-aarch32-' | append: variant | append: '-' | append: builder | append: '-gcc' %}{% assign configs = configs | push: config %}{% endfor %}",
      "add-qemu-aarch64-variants-to-configs-for-builder": "{% for variant in properties.qemu-aarch64-variants %}{% assign config = 'qemu-aarch64-' | append: variant | append: '-' | append: builder | append: '-gcc' %}{% assign configs = configs | push: config %}{% endfor %}",
      "add-qemu-riscv-variants-to-configs-for-builder": "{% for variant in properties.qemu-riscv-variants %}{% assign config = 'qemu-riscv-' | append: variant | append: '-' | append: builder | append: '-gcc' %}{% assign configs = configs | push: config %}{% endfor %}",
      "add-latest-configs-for-builder": "{% if os.platform != 'darwin' %}{{ properties.add-synthetic-posix-gcc-to-configs-for-builder }}{% endif %}{{ properties.add-synthetic-posix-clang-to-configs-for-builder }}{{ properties.add-qemu-cortex-variants-to-configs-for-builder }}{{ properties.add-qemu-aarch32-variants-to-configs-for-builder }}{{ properties.add-qemu-aarch64-variants-to-configs-for-builder }}{{ properties.add-qemu-riscv-variants-to-configs-for-builder }}",
      "compute-latest-cmake-configs": "{% assign configs = '' | split: '' %}{% assign builder = 'cmake' %}{{ properties.add-latest-configs-for-builder }}",
      "compute-latest-meson-configs": "{% assign configs = '' | split: '' %}{% assign builder = 'meson' %}{{ properties.add-latest-configs-for-builder }}",
      "compute-latest-configs": "{% assign configs = '' | split: '' %}{% for builder in properties.builders %}{{ properties.add-latest-configs-for-builder }}{% endfor %}",
      "add-boards-configs": "{% for board in properties.configs-boards %}{% assign config = board | append: '-cmake-gcc' %}{% assign configs = configs | push: config %}{% endfor %}",
      "compute-boards-configs": "{% assign configs = '' | split: '' %}{{ properties.add-boards-configs }}",
      "add-native-gcc-versions-to-configs-for-builder": "{% assign native-gcc-versions = properties.native-gcc-versions | split_lines %}{% for version in native-gcc-versions %}{% assign config = 'synthetic-posix-' | append: builder | append: '-gcc' | append: version %}{% assign configs = configs | push: config %}{% endfor %}",
      "add-native-clang-versions-to-configs-for-builder": "{% assign native-clang-versions = properties.native-clang-versions | split_lines %}{% for version in native-clang-versions %}{% assign config = 'synthetic-posix-' | append: builder | append: '-clang' | append: version %}{% assign configs = configs | push: config %}{% endfor %}",
      "add-qemu-cortex-variants-versions-to-configs-for-builder": "{% assign arm-none-eabi-gcc-versions = properties.arm-none-eabi-gcc-versions | split_lines %}{% for variant in properties.qemu-cortex-variants %}{% for version in arm-none-eabi-gcc-versions %}{% assign config = 'qemu-cortex-' | append: variant | append: '-' | append: builder | append: '-gcc' | append: version %}{% assign configs = configs | push: config %}{% endfor %}{% endfor %}",
      "add-qemu-aarch32-variants-versions-to-configs-for-builder": "{% assign arm-none-eabi-gcc-versions = properties.arm-none-eabi-gcc-versions | split_lines %}{% for variant in properties.qemu-aarch32-variants %}{% for version in arm-none-eabi-gcc-versions %}{% assign config = 'qemu-aarch32-' | append: variant | append: '-' | append: builder | append: '-gcc' | append: version %}{% assign configs = configs | push: config %}{% endfor %}{% endfor %}",
      "add-qemu-aarch64-variants-versions-to-configs-for-builder": "{% assign arm-none-eabi-gcc-versions = properties.arm-none-eabi-gcc-versions | split_lines %}{% for variant in properties.qemu-aarch64-variants %}{% for version in arm-none-eabi-gcc-versions %}{% assign config = 'qemu-aarch64-' | append: variant | append: '-' | append: builder | append: '-gcc' | append: version %}{% assign configs = configs | push: config %}{% endfor %}{% endfor %}",
      "add-qemu-riscv-variants-versions-to-configs-for-builder": "{% assign riscv-none-elf-gcc-versions = properties.riscv-none-elf-gcc-versions | split_lines %}{% for variant in properties.qemu-riscv-variants %}{% for version in riscv-none-elf-gcc-versions %}{% assign config = 'qemu-riscv-' | append: variant | append: '-' | append: builder | append: '-gcc' | append: version %}{% assign configs = configs | push: config %}{% endfor %}{% endfor %}",
      "add-all-configs-for-builder": "{{ properties.add-synthetic-posix-sys-to-configs-for-builder }}{% if os.platform != 'darwin' %}{{ properties.add-native-gcc-versions-to-configs-for-builder }}{% endif %}{{ properties.add-native-clang-versions-to-configs-for-builder }}{{ properties.add-qemu-cortex-variants-versions-to-configs-for-builder }}{{ properties.add-qemu-aarch32-variants-versions-to-configs-for-builder }}{{ properties.add-qemu-aarch64-variants-versions-to-configs-for-builder }}{{ properties.add-qemu-riscv-variants-versions-to-configs-for-builder }}",
      "compute-all-cmake-configs": "{% assign configs = '' | split: '' %}{% assign builder = 'cmake' %}{{ properties.add-all-configs-for-builder }}",
      "compute-all-meson-configs": "{% assign configs = '' | split: '' %}{% assign builder = 'meson' %}{{ properties.add-all-configs-for-builder }}",
      "compute-all-configs": "{% assign configs = '' | split: '' %}{% for builder in properties.builders %}{{ properties.add-all-configs-for-builder }}{% endfor %}",
      "actions-install-for-configs": "{% for config in configs %}{% for build-type in properties.build-types %}xpm install --config {{ config }}-{{ build-type }}{{ os.EOL }}{% endfor %}{% endfor %}",
      "actions-link-dependencies-for-configs": "{% for config in configs %}{% for build-type in properties.build-types %}xpm run link-dependencies --config {{ config }}-{{ build-type }}{{ os.EOL }}{% endfor %}{% endfor %}",
      "actions-setup-build-test-for-configs": "{% for config in configs %}{{ properties.actions-setup-build-test-for-config }}{% endfor %}",
      "actions-setup-build-test-for-config": "{% for build-type in properties.build-types %}{% for test-action in properties.test-actions %}xpm run {{ test-action }} --config {{ config }}-{{ build-type }}{{ os.EOL }}{% endfor %}{% endfor %}",
      "actions-build-for-configs": "{% for config in configs %}{{ properties.action-build-for-config }}{{ os.EOL }}{% endfor %}",
      "actions-test-for-configs": "{% for config in configs %}{{ properties.action-test-for-config }}{{ os.EOL }}{% endfor %}",
      "action-test-for-config": "xpm run test-{{ config }}",
      "action-build-for-config": "xpm run build-{{ config }}",
      "actions-clean-for-configs": "{% for config in configs %}{% for build-type in properties.build-types %}xpm run clean --config {{ config }}-{{ build-type }} --ignore-errors{{ os.EOL }}{% endfor %}{% endfor %}",
      "actions-clear-for-configs": "{% for config in configs %}{% for build-type in properties.build-types %}xpm run clear --config {{ config }}-{{ build-type }} --ignore-errors{{ os.EOL }}{% endfor %}{% endfor %}",
