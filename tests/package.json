    "buildConfigurations": {
      "cmake-synthetic-posix-actions": {
        "hidden": true,
        "actions": {
          "setup": "{{ properties.commandCMakeGenerateNativePosixWithToolchain }}",
          "build": [
            "{{ properties.commandCMakeRefresh }}",
            "{{ properties.commandCMakeBuild }}"
          ],
          "test": "{{ properties.commandCMakePerformTests }}",
          "clean": "{{ properties.commandCMakeClean }}"
        }
      },
      "cmake-cross-actions": {
        "hidden": true,
        "inherits": [
          "cmake-synthetic-posix-actions"
        ],
        "actions": {
          "setup": "{{ properties.commandCMakeGenerateCross }}",
          "clear": "{{ properties.commandClearBuildFolder }}"
        }
      },
      "synthetic-posix-actions": {
        "hidden": true,
        "actions": {
          "install": [
            "xpm install --config {{ configuration.name }}"
          ],
          "clear": "{{ properties.commandClearBuildFolder }}"
        }
      },
      "cortexm-actions": {
        "hidden": true,
        "actions": {
          "install": [
            "xpm install --config {{ configuration.name }}"
          ]
        }
      },
      "synthetic-posix-dependencies": {
        "hidden": true,
        "devDependencies": {
          "@micro-os-plus/posix-arch": "{{ properties.dependencies-releases['@micro-os-plus/posix-arch'] }}",
          "@xpack-3rd-party/libucontext": "{{ properties.dependencies-releases['@xpack-3rd-party/libucontext'] }}"
        },
        "actions": {
          "link-dependencies": [
            "xpm link @micro-os-plus/micro-os-plus-iii-posix-arch --config {{ configuration.name }}",
            "xpm link @xpack-3rd-party/libucontext --config {{ configuration.name }}"
          ]
        }
      },
      "cortexm-dependencies": {
        "hidden": true,
        "devDependencies": {
          "@micro-os-plus/micro-os-plus-iii-cortexm": "{{ properties.dependencies-releases['@micro-os-plus/micro-os-plus-iii-cortexm'] }}",
          "@xpack-3rd-party/arm-cmsis-core": "{{ properties.dependencies-releases['@xpack-3rd-party/arm-cmsis-core'] }}"
        },
        "actions": {
          "link-dependencies": [
            "xpm link @micro-os-plus/micro-os-plus-iii-cortexm --config {{ configuration.name }}",
            "xpm link @xpack-3rd-party/arm-cmsis-core --config {{ configuration.name }}"
          ]
        }
      },
      "synthetic-posix-gcc-dependencies": {
        "hidden": true,
        "inherits": [
          "synthetic-posix-gcc{{ properties.native-gcc-releases | keys | reverse | first }}-dependencies"
        ]
      },
      "synthetic-posix-gcc{{ matrix.native-gcc-version }}-dependencies": {
        "matrix": {
          "native-gcc-version": [
            "{{ properties.native-gcc-versions | join_lines }}"
          ]
        },
        "template": {
          "hidden": true,
          "devDependencies": {
            "@xpack-dev-tools/gcc": {
              "specifier": "{{ properties.native-gcc-releases[matrix.native-gcc-version].specifier }}",
              "platforms": "{{ properties.native-gcc-releases[matrix.native-gcc-version].platforms }}"
            }
          }
        }
      },
      "synthetic-posix-clang-dependencies": {
        "hidden": true,
        "inherits": [
          "synthetic-posix-clang{{ properties.native-clang-releases | keys | reverse | first }}-dependencies"
        ]
      },
      "synthetic-posix-clang{{ matrix.native-clang-version }}-dependencies": {
        "matrix": {
          "native-clang-version": [
            "{{ properties.native-clang-versions | join_lines }}"
